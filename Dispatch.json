    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "# Безопасное извлечение payload (работает и если данные лежат в body, и если сразу в корне json)\nraw_data = _item.get('json', {})\npayload = raw_data.get('body', raw_data)\n\n# Безопасная валидация сотрудников (защита от None, строк \"50\", мусора)\nraw_employees = payload.get('employees') or payload.get('employee_count', 0)\ntry:\n    employees = int(raw_employees)\nexcept (ValueError, TypeError):\n    employees = 0\n\n# Многофакторный B2B Lead Scoring\ntarget_industries = {'saas', 'tech', 'software', 'it', 'ecommerce', 'b2b'}\nindustry = str(payload.get('industry', '')).strip().lower()\n\nscore = 0\n\n# 1. Размер компании\nif 20 <= employees <= 500:\n    score += 40  # Sweet spot для outbound\nelif employees > 500:\n    score += 30\nelif employees >= 10:\n    score += 15\n\n# 2. Отраслевое соответствие\nif any(target in industry for target in target_industries):\n    score += 40\n\n# 3. Наличие контактных данных\nif payload.get('contact_email') or payload.get('email'):\n    score += 20\n\n# Возвращаем обогащенный объект (сохраняя ВСЕ исходные поля для Gmail и Sheets)\noutput = dict(payload)\noutput.update({\n    \"lead_score\": score,\n    \"status\": \"QUALIFIED\" if score >= 60 else \"DISQUALIFIED\",\n    \"enrichment_tier\": \"TIER_1\" if score >= 80 else (\"TIER_2\" if score >= 60 else \"LOW_FIT\"),\n    \"processed_at\": _item.get('json', {}).get('timestamp')\n})\n\nreturn output"
      },
